{
  "name": "quickstart-templates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node node_modules/@stihl-design-system/components/partials/copyAssets.js --dir=src/app --mode=nextWithAppRouter",
    "build": "next build",
    "build:test": "NODE_ENV=test next build",
    "start": "serve -c serve.json",
    "lint": "eslint .",
    "test:a11y": "npx playwright test --config=playwright.config.a11y.ts",
    "test:vrt": "npx playwright test --config=playwright.config.vrt.ts"
  },
  "dependencies": {
    "@stihl-design-system/components": "1.0.0-RC.53",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-html-reporter": "^2.2.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "sass": "^1.105.1",
    "serve": "^14.2.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "compression": "^1.8.2",
    "shell-quote": "^1.12.0"
  }
}
